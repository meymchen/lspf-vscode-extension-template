{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build language server",
      "type": "process",
      "command": "cargo",
      "args": [
        "build"
      ],
      "problemMatcher": "$rustc",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "install extension dependencies",
      "type": "process",
      "command": "npm",
      "args": [
        "--prefix",
        "extension",
        "install"
      ],
      "problemMatcher": []
    },
    {
      "label": "bundle extension",
      "type": "npm",
      "script": "bundle",
      "path": "extension",
      "problemMatcher": "$tsc"
    },
    {
      "label": "prepare extension development host",
      "dependsOrder": "sequence",
      "dependsOn": [
        "build language server",
        "install extension dependencies",
        "bundle extension"
      ],
      "problemMatcher": []
    },
    {
      "label": "test language server",
      "type": "process",
      "command": "cargo",
      "args": [
        "test"
      ],
      "problemMatcher": "$rustc",
      "group": "test"
    },
    {
      "label": "test extension",
      "type": "npm",
      "script": "test",
      "path": "extension",
      "problemMatcher": "$tsc",
      "group": "test"
    },
    {
      "label": "test all",
      "dependsOrder": "sequence",
      "dependsOn": [
        "test language server",
        "test extension"
      ],
      "problemMatcher": [],
      "group": {
        "kind": "test",
        "isDefault": true
      }
    }
  ]
}
