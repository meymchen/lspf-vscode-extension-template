{
  "name": "lspf-hello",
  "displayName": "LSPF Hello",
  "description": "A minimal VS Code language extension backed by an lspf server.",
  "version": "0.1.0",
  "publisher": "lspf-template",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "lspf-hello",
        "aliases": [
          "LSPF Hello"
        ],
        "extensions": [
          ".hello"
        ]
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p .",
    "test": "npm run compile && node --test \"out/test/**/*.test.js\"",
    "bundle": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "prepare:server": "node scripts/prepareServer.mjs",
    "vscode:prepublish": "npm run bundle && npm run prepare:server",
    "package": "vsce package --no-dependencies --allow-missing-repository"
  },
  "dependencies": {
    "vscode-languageclient": "^10.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/vscode": "~1.91.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
